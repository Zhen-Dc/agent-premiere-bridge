{
  "name": "agent-premiere-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Localhost bridge between AI agents and Adobe Premiere Pro via CEP and ExtendScript.",
  "type": "module",
  "scripts": {
    "start": "node server/src/index.js",
    "queue": "node cli/queue-job.js",
    "queue:edit-plan": "node cli/queue-edit-plan.js",
    "diagnostics": "powershell -ExecutionPolicy Bypass -File scripts/diagnostics.ps1",
    "detect:premiere": "powershell -ExecutionPolicy Bypass -File scripts/detect-premiere.ps1",
    "install:cep": "powershell -ExecutionPolicy Bypass -File scripts/install-cep.ps1",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-bridge.ps1",
    "launch": "powershell -ExecutionPolicy Bypass -File scripts/start-bridge.ps1"
  },
  "engines": {
    "node": ">=20"
  }
}

